# Required for /admin — leave blank until you generate real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Production storage for events and selected Facebook posts. Use the pooled
# connection string from Neon (or the Vercel Neon integration). Leave unset in
# local development to use the JSON files in data/ instead.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional, file storage only: use a persistent mounted path instead of
# data/events.json. Ignored when DATABASE_URL is set.
# EVENTS_FILE_PATH=/var/lib/ccsweb/events.json

# Optional: enables protected Facebook Page post selection in /admin.
# The Page ID is public; keep the access token only in deployment secrets.
FACEBOOK_PAGE_ID=110700467422954
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional, file storage only. Ignored when DATABASE_URL is set.
# FACEBOOK_POSTS_FILE_PATH=/var/lib/ccsweb/facebook-posts.json
